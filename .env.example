# ---------------------------------------------------------------------------
# Veriflow environment configuration
# Copy to .env and adjust. Never commit a real .env.
# ---------------------------------------------------------------------------

# Product / runtime -----------------------------------------------------------
PRODUCT_NAME=Veriflow
APP_ENV=local                   # local | test | production
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
API_PORT=8000

# Persistence -----------------------------------------------------------------
# Host-side URL (docker compose maps postgres to 5433 to avoid local conflicts).
DATABASE_URL=postgresql+psycopg://veriflow:veriflow@localhost:5433/veriflow
# Used by the automated integration tests (created/dropped by the suite).
TEST_DATABASE_URL=postgresql+psycopg://veriflow:veriflow@localhost:5433/veriflow_test
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# Redis / Celery --------------------------------------------------------------
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

# Workflow execution ----------------------------------------------------------
# celery = real distributed workers, inline = run in-process (tests / no broker)
WORKFLOW_EXECUTOR=celery
MAX_PARALLEL_INVESTIGATIONS=4
MAX_PLAN_TASKS=40
MAX_INVESTIGATION_CANDIDATES=10
MAX_TOOL_CALLS_PER_TASK=25
MAX_RETRIEVAL_CHUNKS=8
MAX_OBJECTIVE_CHARS=4000
TASK_MAX_RETRIES=3

# LLM provider ----------------------------------------------------------------
# openai = live API (requires OPENAI_API_KEY), fake = deterministic local model
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4096
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Embeddings ------------------------------------------------------------------
# local = deterministic hashed embeddings (no network), openai = live embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Pricing used for estimated-cost reporting (USD per 1M tokens)
LLM_INPUT_COST_PER_MTOK=0.15
LLM_OUTPUT_COST_PER_MTOK=0.60
EMBEDDING_COST_PER_MTOK=0.02

# Observability ---------------------------------------------------------------
OTEL_ENABLED=false
OTEL_SERVICE_NAME=veriflow-api
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Web / security --------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Leave empty for an open development boundary. When set, all /api/v1 requests
# must send `X-API-Key: <value>` (health and docs stay public).
API_KEY=
API_MAX_PAGE_SIZE=100

# Failure injection (development only; forced off when APP_ENV=production) -----
FAILURE_INJECTION_ENABLED=false
LLM_FAILURE_RATE=0.0
VECTOR_FAILURE_RATE=0.0
API_FAILURE_RATE=0.0

# Synthetic data --------------------------------------------------------------
SEED_RANDOM_SEED=20260301
SEED_CUSTOMER_COUNT=3000

# Frontend (read at build/run time by Next.js) --------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_PRODUCT_NAME=Veriflow
NEXT_PUBLIC_API_KEY=
# WebGL liquid-glass accent on the hero composer: on | off (see docs/frontend.md)
NEXT_PUBLIC_LIQUID_GLASS=off
